# Copy this to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables instead
# (DATABASE_URL is set for you automatically when you add a Postgres database).

# Set automatically by Vercel when you add a Postgres database (Storage tab).
# For local dev, paste the connection string from that same Storage tab.
DATABASE_URL=

# Any long random string. Used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# The password you (the admin) type in at /admin to manage schemes.
ADMIN_PASSWORD=

# Any long random string. Vercel Cron sends this back as a Bearer token so
# /api/cron/scan can tell a real scheduled run from a random visitor.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
